managed implementation in class zcl_projects_crud unique;
strict( 2 );
with draft;

define behavior for zekf_rv_projects
persistent table zekf_t_projects
draft table zekf_d_projects
lock master
total etag ProjectId
authorization master ( instance )


{
  create ( authorization : global );
  update;
  delete;
  draft determine action Prepare;
  field ( readonly : update ) ProjectId;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;

  field ( features : instance ) Budget;

  mapping for zekf_t_projects
    {
      ProjectId    = project_id;
      StartDate    = start_date;
      EndDate      = end_date;
      Budget       = budget;
      CurrencyCode = currency_code;
      Manager      = manager;
    }
}